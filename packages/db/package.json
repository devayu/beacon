{
  "name": "@beacon/db",
  "version": "1.0.0",
  "description": "Shared database connection and models for Beacon services",
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "database",
    "prisma",
    "beacon",
    "shared"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@beacon/logger": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "prisma": "^7.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
